# =========================================================
# 🔐 GLOBAL SECURITY (CRITICAL)
# =========================================================

# Cryptographic keys
*.pem
*.key
*.p12
*.pfx

# Encrypted data
*.enc

# Databases
*.db
*.sqlite
*.sqlite3

# Environment secrets
.env
.env.*
!.env.example

# =========================================================
# 🧠 EDITOR / OS FILES
# =========================================================

.vscode/
.idea/
.cursor/
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# =========================================================
# 📦 NODE / FRONTEND
# =========================================================

node_modules/
dist/
build/
coverage/
.npm/
.yarn/

frontend/node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/
frontend/playwright/.auth/

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================================================
# 🐍 PYTHON / BACKEND
# =========================================================

__pycache__/
*.py[cod]
*$py.class

venv/
.venv/
env/

.pytest_cache/
htmlcov/
site/

# Flask instance
backend/instance/

# Logs
*.log
logs/

# =========================================================
# ☁️ CLOUD STORAGE (SIMULATION DATA)
# Keep structure, ignore contents
# =========================================================

backend/cloud/keys/*
!backend/cloud/keys/.gitkeep

backend/cloud/data/*
!backend/cloud/data/.gitkeep

backend/cloud/meta/*
!backend/cloud/meta/.gitkeep

# fallback safety
backend/cloud/*
!backend/cloud/.gitkeep

# Root-level cloud (legacy)
cloud/keys/*
!cloud/keys/.gitkeep

cloud/data/*
!cloud/data/.gitkeep

cloud/meta/*
!cloud/meta/.gitkeep

cloud/*
!cloud/.gitkeep

# =========================================================
# 📊 GENERATED / RUNTIME FILES
# =========================================================

backend/benchmark_results.csv
backend/test_record_v1.txt

# Audit logs (sensitive)
backend/app/services/audit/*.log

# =========================================================
# 🧪 TEST ARTIFACTS
# =========================================================

playwright-report/
test-results/

# =========================================================
# 📄 PRIVATE / LOCAL FILES
# =========================================================

private_reference.md